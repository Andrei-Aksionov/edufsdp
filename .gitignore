# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Environments & Dependency Management
.venv/
uv.lock # Keep uncommented if you want to track it; comment out if local-only

# Test / Linter / Type Checker Caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.lycheecache

# VS Code (ignore all, but explicitly track launch.json)
.vscode/*
!.vscode/launch.json

# Training checkpoints & local artifacts
checkpoints/

# OS-specific files
.DS_Store
Thumbs.db
